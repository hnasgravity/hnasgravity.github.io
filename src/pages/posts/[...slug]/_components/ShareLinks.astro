---
import LinkButton from "@/components/LinkButton.astro";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";
import QRCode from "qrcode";

const { shareLinks } = config;
const t = useTranslations(Astro.currentLocale);

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

const pageUrl = Astro.url;

// WeChat has no web share endpoint; sharing works by scanning a QR code
// of the page URL. The QR is generated at build time per post.
const wechatQrSvg = shareLinks.some(({ name }) => name === "wechat")
  ? await QRCode.toString(pageUrl.href, {
      type: "svg",
      margin: 2,
      width: 160,
      color: { dark: "#000000", light: "#ffffff" },
    })
  : null;

const platformLabel = (name: string) =>
  name.charAt(0).toUpperCase() + name.slice(1);

const items = await Promise.all(
  shareLinks.map(async ({ name, url, linkTitle }) => {
    const mod = await icons[`/src/assets/icons/socials/${name}.svg`]?.();
    const Icon = mod?.default;
    const title =
      linkTitle ??
      (name === "mail"
        ? t.post.sharePostViaEmail
        : tplStr(t.post.sharePostOn, { platform: platformLabel(name) }));
    return { name, url, title, Icon };
  })
);
---

{
  items.some(({ Icon }) => Icon) && (
    <div class="flex flex-none flex-col items-center justify-center gap-1 md:items-start">
      <span class="italic">{t.post.sharePostIntro}</span>
      <div class="text-center">
        {items.map(({ name, url, title, Icon }) =>
          !Icon ? null : name === "wechat" ? (
            <details class="group/wechat relative inline-block align-bottom">
              <summary
                class="inline-block scale-90 cursor-pointer list-none p-2 hover:rotate-6 [&::-webkit-details-marker]:hidden sm:p-1"
                title={title}
              >
                <Icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 sm:scale-110" />
                <span class="sr-only">{title}</span>
              </summary>
              <div class="border-border bg-background absolute right-0 bottom-full z-10 mb-2 w-max rounded-md border p-3 shadow-lg">
                <div
                  class="w-40 rounded bg-white"
                  set:html={wechatQrSvg}
                />
                <p class="mt-2 text-center text-xs whitespace-nowrap opacity-80">
                  {t.post.sharePostViaWechatQr}
                </p>
              </div>
            </details>
          ) : (
            <LinkButton
              href={`${url}${pageUrl}`}
              class="scale-90 p-2 hover:rotate-6 sm:p-1"
              title={title}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110" />
              <span class="sr-only">{title}</span>
            </LinkButton>
          )
        )}
      </div>
    </div>
  )
}
